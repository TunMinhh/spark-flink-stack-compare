# Pipeline B configuration template.
# Copy this file to .env, then fill in real local/VPS secrets.
# Do not commit .env.

# Kafka KRaft
KAFKA_CLUSTER_ID=4L6g3nShT-eMCtK--X86sw

# PostgreSQL metadata for MLflow and Iceberg catalog
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=postgres

# MinIO artifact store for MLflow only.
# Pipeline B's Iceberg warehouse now uses HDFS:
# hdfs://namenode:9000/warehouse/iceberg
MINIO_ROOT_USER=change-me-minio-user
MINIO_ROOT_PASSWORD=change-me-minio-password

# MLflow artifact credentials. Keep these aligned with MinIO above.
AWS_ACCESS_KEY_ID=change-me-minio-user
AWS_SECRET_ACCESS_KEY=change-me-minio-password

# Postgres sink used by Grafana
PG_SINK_USER=grafana
PG_SINK_PASSWORD=change-me-grafana-postgres-password
PG_SINK_DB=wellness

# Grafana login
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-admin-password

# AttentionLSTM training
MLFLOW_EXPERIMENT=intraday-anomaly-detector
MLFLOW_MODEL_NAME=intraday-attention-lstm
AI_SEQ_LEN=30
AI_MIN_WINDOWS=50
AI_HIDDEN_SIZE=64
AI_NUM_LAYERS=2
AI_BATCH_SIZE=64
AI_LR=0.001
AI_THRESH_GREEN=1.04
AI_THRESH_YELLOW=1.29
AI_THRESH_RED=1.65
EPOCHS=15
