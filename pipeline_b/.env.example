# Pipeline B local configuration template.
# Copy to .env for local runs and change passwords before any shared/VPS use.

# Kafka KRaft
KAFKA_CLUSTER_ID=4L6g3nShT-eMCtK--X86sw

# PostgreSQL metadata for MLflow and Iceberg catalog
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

# MinIO warehouse and artifact store
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# MLflow artifact credentials. Keep these aligned with MinIO above.
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin123

# Postgres sink used by Grafana
PG_SINK_USER=grafana
PG_SINK_PASSWORD=grafana123
PG_SINK_DB=wellness

# Grafana login
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# AttentionLSTM training
MLFLOW_EXPERIMENT=intraday-anomaly-detector
MLFLOW_MODEL_NAME=intraday-attention-lstm
AI_SEQ_LEN=30
AI_MIN_WINDOWS=50
AI_HIDDEN_SIZE=64
AI_NUM_LAYERS=2
AI_BATCH_SIZE=64
AI_LR=0.001
AI_THRESH_GREEN=1.04
AI_THRESH_YELLOW=1.29
AI_THRESH_RED=1.65
EPOCHS=15
